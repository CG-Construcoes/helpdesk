generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String               @id @default(uuid())
  name                  String
  email                 String               @unique
  password              String
  role                  String               @default("SOLICITANTE")
  roleId                String?
  avatar                String?
  department            String?
  sectorId              String?
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  signatureHtml         String?
  requirePasswordChange Boolean              @default(false)
  auditLogs             AuditLog[]
  notifications         Notification[]
  passwordResetTokens   PasswordResetToken[]
  ticketComments        TicketComment[]
  ticketHistory         TicketHistory[]
  ticketPauses          TicketPause[]
  assignedTickets       Ticket[]             @relation("TicketTechnician")
  userPermissions       UserPermission[]
  roleRef               Role?                @relation(fields: [roleId], references: [id])
  sector                Sector?              @relation(fields: [sectorId], references: [id])

  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@index([role, isActive])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  label       String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  label           String
  category        String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model Company {
  id        String    @id @default(uuid())
  name      String    @unique
  logo      String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  settings  Settings?

  @@map("companies")
}

model Settings {
  id                     String    @id @default(uuid())
  companyId              String    @unique
  systemName             String    @default("CG Construções HelpDesk")
  theme                  String    @default("system")
  primaryColor           String    @default("#2563eb")
  secondaryColor         String    @default("#f1f5f9")
  department             String    @default("Departamento de TI")
  cnpj                   String    @default("12.345.678/0001-99")
  phone                  String    @default("(11) 3456-7890")
  email                  String    @default("ti@cgconstrucoes.com.br")
  website                String    @default("www.cgconstrucoes.com.br")
  address                String    @default("Av. Principal, 1000 - Centro")
  favicon                String    @default("/cg-logo.png")
  borderRadius           String    @default("0.5rem")
  compactMode            Boolean   @default(false)
  allowRegistration      Boolean   @default(false)
  minPasswordLen         Int       @default(8)
  sessionTimeoutMin      Int       @default(120)
  requireFirstAccess     Boolean   @default(true)
  maxLoginAttempts       Int       @default(5)
  defaultStatus          String    @default("ABERTO")
  defaultOrigin          String    @default("MANUAL")
  defaultPriority        String    @default("MEDIA")
  defaultSlaHours        Int       @default(24)
  autoArchive            Boolean   @default(true)
  archiveDays            Int       @default(30)
  monthlyNumbering       Boolean   @default(true)
  reportShowLogo         Boolean   @default(true)
  reportShowFooter       Boolean   @default(true)
  reportDefaultTheme     String    @default("LIGHT")
  auditRetentionDays     Int       @default(90)
  auditLogEnabled        Boolean   @default(true)
  googleRefreshToken     String?
  emailIntegrationStatus String    @default("DISCONNECTED")
  lastEmailCheck         DateTime?
  lastEmailProcessed     DateTime?
  emailCheckError        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  recessActive           Boolean   @default(false)
  recessReturnDate       DateTime?
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model ProcessedEmail {
  id            String    @id @default(uuid())
  messageId     String    @unique
  subject       String?
  from          String?
  receivedAt    DateTime?
  processedAt   DateTime  @default(now())
  ticketId      String?
  status        String    @default("PROCESSED")
  bodyReceived  String?
  bodySent      String?
  cc            String?
  manualReplies Json?
  ticket        Ticket?   @relation(fields: [ticketId], references: [id])

  @@map("processed_emails")
}

model SentEmail {
  id          String   @id @default(uuid())
  to          String
  subject     String
  bodyHtml    String?
  ticketId    String?
  reason      String
  sentAt      DateTime @default(now())
  ticket      Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([sentAt])
  @@map("sent_emails")
}

model Requester {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  phone      String?
  company    String?
  department String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  sectorId   String?
  sector     Sector?   @relation(fields: [sectorId], references: [id])
  tickets    Ticket[]

  @@index([email])
  @@index([deletedAt])
  @@map("requesters")
}

model Sector {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  requesters  Requester[]
  tickets     Ticket[]
  users       User[]

  @@index([name])
  @@index([deletedAt])
  @@index([isActive, deletedAt])
  @@map("sectors")
}

model Service {
  id          String    @id @default(uuid())
  name        String    @unique
  category    String?
  description String?
  slaHours    Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tickets     Ticket[]

  @@index([name])
  @@index([deletedAt])
  @@map("services")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model TicketOrigin {
  id        String     @id @default(uuid())
  code      OrigemType @unique
  label     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("ticket_origins")
}

model TicketStatus {
  id        String     @id @default(uuid())
  code      StatusType @unique
  label     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("ticket_statuses")
}

model TicketPriority {
  id        String         @id @default(uuid())
  code      PrioridadeType @unique
  label     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("ticket_priorities")
}

model Ticket {
  id               String             @id @default(uuid())
  ticketNumber     Int                @default(1)
  ticketMonthYear  String             @default("07-2026")
  problem          String
  description      String?
  requesterId      String
  sectorId         String?
  technicianId     String?
  serviceId        String?
  status           StatusType         @default(ABERTO)
  origin           OrigemType         @default(MANUAL)
  priority         PrioridadeType     @default(MEDIA)
  ticketDate       DateTime           @default(now())
  dueDate          DateTime?
  startTime        DateTime?
  endTime          DateTime?
  totalTimeMinutes Int?
  observations     String?
  aiSummary        String?
  aiMetadata       Json?
  cc               String?
  hasUnreadReply   Boolean            @default(false)
  isArchived       Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?          // Soft delete

  // Relacionamentos Hierárquicos (Pai/Filho)
  parentId         String?            // ID do chamado pai (opcional)
  parent           Ticket?            @relation("TicketHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         Ticket[]           @relation("TicketHierarchy")
  solution         String?
  processedEmails  ProcessedEmail[]
  sentEmails       SentEmail[]
  attachments      TicketAttachment[]
  comments         TicketComment[]
  history          TicketHistory[]
  pauses           TicketPause[]
  requester        Requester          @relation(fields: [requesterId], references: [id])
  sector           Sector?            @relation(fields: [sectorId], references: [id])
  service          Service?           @relation(fields: [serviceId], references: [id])
  technician       User?              @relation("TicketTechnician", fields: [technicianId], references: [id])

  @@unique([ticketNumber, ticketMonthYear])
  @@index([ticketNumber])
  @@index([ticketMonthYear])
  @@index([requesterId])
  @@index([sectorId])
  @@index([technicianId])
  @@index([serviceId])
  @@index([status])
  @@index([isArchived])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([technicianId, status])
  @@index([serviceId, status])
  @@index([sectorId, status])
  @@index([ticketDate, status])
  @@index([ticketMonthYear, status])
  @@index([parentId, deletedAt])
  @@index([requesterId, deletedAt])
  @@index([ticketDate, deletedAt])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  authorId   String
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_comments")
}

model TicketHistory {
  id          String   @id @default(uuid())
  ticketId    String
  actorId     String?
  actorName   String?
  eventType   String
  description String
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id])
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([actorId])
  @@map("ticket_history")
}

model TicketAttachment {
  id           String   @id @default(uuid())
  ticketId     String
  fileName     String
  fileUrl      String
  fileSize     Int?
  uploadedById String?
  createdAt    DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_attachments")
}

model ReportLayout {
  id        String   @id @default(uuid())
  name      String
  config    Json
  isDefault Boolean  @default(false)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("report_layouts")
}

model ImportLog {
  id             String   @id @default(uuid())
  fileName       String
  totalRows      Int
  importedRows   Int
  skippedRows    Int
  newRequesters  Int      @default(0)
  newSectors     Int      @default(0)
  newServices    Int      @default(0)
  newTechnicians Int      @default(0)
  durationMs     Int      @default(0)
  importedBy     String?
  monthYear      String?
  createdAt      DateTime @default(now())

  @@map("import_logs")
}

model TicketPause {
  id        String    @id @default(uuid())
  ticketId  String
  userId    String?
  reason    String?
  startTime DateTime  @default(now())
  endTime   DateTime?
  duration  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_pauses")
}

model EmailTemplate {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  subject      String
  bodyHtml     String
  showPriority Boolean  @default(true)
  showStatus   Boolean  @default(true)
  primaryColor String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("email_templates")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}



enum StatusType {
  EM_ATENDIMENTO
  CONCLUIDO
  AGUARDANDO
  AGENDADO
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO_USUARIO
  AGUARDANDO_PECA
  AGUARDANDO_TERCEIROS
  RESOLVIDO
  CANCELADO
}

enum OrigemType {
  MANUAL
  WHATSAPP
  EMAIL
}

enum PrioridadeType {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}
